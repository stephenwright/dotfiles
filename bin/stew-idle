#!/bin/bash

# Idle inhibitor using systemd-inhibit

set -euo pipefail

INHIBIT_WHO="stew-caffeine"

is_inhibited() {
    pgrep -f "systemd-inhibit.*--who=$INHIBIT_WHO" >/dev/null
}

toggle() {
    if is_inhibited; then
        pkill -f "systemd-inhibit.*--who=$INHIBIT_WHO"
        notify-send -u normal "stew idle" "Caffeine mode: off" -i preferences-system-power
    else
        systemd-inhibit --what=idle --who="$INHIBIT_WHO" --why="Caffeine mode" sleep infinity &
        disown
        notify-send -u normal "stew idle" "Caffeine mode: on" -i preferences-system-power
    fi
}

case "${1:-status}" in
    toggle)
        toggle
        ;;
    status)
        is_inhibited && echo "disabled" || echo "enabled"
        ;;
    *)
        echo "Usage: $0 [toggle|status]" >&2
        exit 1
        ;;
esac
