#!/bin/bash

# Wallpaper management for Hyprland; the picker UI lives in quickshell

set -e

WALLPAPER_DIR="$HOME/wallpaper"
HYPRPAPER_CONFIG="$HOME/.config/hypr/hyprpaper.conf"

apply_wallpaper() {
    local wallpaper="$1"

    hyprctl hyprpaper wallpaper ", $wallpaper" 2>/dev/null

    # Update config for persistence
    {
        echo "wallpaper {"
        echo "    monitor ="
        echo "    path = $wallpaper"
        echo "}"
    } > "$HYPRPAPER_CONFIG"
}

case "${1}" in
    current)
        path=$(awk -F' = ' '$1 ~ /path/ { print $2 }' "$HYPRPAPER_CONFIG")
        echo "${path/#\~/$HOME}"
        ;;

    set)
        [[ -z "$2" ]] && { echo "Usage: $0 set <file>" >&2; exit 1; }

        target_file="${2/#\~/$HOME}"
        [[ ! -f "$target_file" ]] && target_file="$WALLPAPER_DIR/$2"
        [[ ! -f "$target_file" ]] && { echo "Wallpaper not found: $2" >&2; exit 1; }

        apply_wallpaper "$target_file"
        ;;

    pick)
        exec qs ipc call panels toggle wallpaper
        ;;

    reload)
        pkill hyprpaper 2>/dev/null || true
        hyprpaper >/dev/null 2>&1 &
        ;;

    *)
        echo "Usage: $0 [current|set <file>|pick|reload]"
        exit 1
        ;;
esac
