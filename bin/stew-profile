#!/bin/bash

# Hyprland workspace/monitor profile management

set -e

STATE_FILE="$HOME/.cache/hypr_current_profile"
EXTERNAL_CACHE="$HOME/.cache/hypr_external_monitor"
LAPTOP="eDP-1"
EXTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name != "eDP-1") | .name' | head -n1)

# If no external monitor detected but we have a cached name, use it (for unmirror)
if [[ -z "$EXTERNAL" ]] && [[ -f "$EXTERNAL_CACHE" ]]; then
    EXTERNAL=$(cat "$EXTERNAL_CACHE")
elif [[ -n "$EXTERNAL" ]]; then
    # Cache the external monitor name when we see it
    echo "$EXTERNAL" > "$EXTERNAL_CACHE"
fi

mkdir -p "$(dirname "$STATE_FILE")"

# workspaces, p=primary, e=external when available
# 1 - e - term
# 2 - p - firefox
# 3 - e - code
# 4 - e - chrome
# 5 - p - slack
# 6 - p - discord
# 7 - p - spotify

swap_workspace() {
  local aw am
  aw=$(hyprctl activeworkspace -j | jq -r '.id')
  am=$(hyprctl activeworkspace -j | jq -r '.monitor')

  if [[ -n "$EXTERNAL" ]]; then
    if [[ "$am" == "$LAPTOP" ]]; then
      hyprctl dispatch moveworkspacetomonitor "$aw" "$EXTERNAL"
    elif [[ "$am" == "$EXTERNAL" ]]; then
      hyprctl dispatch moveworkspacetomonitor "$aw" "$LAPTOP"
    fi
  fi
}

# Disable mirroring on external monitor
disable_mirror() {
    local current=$(get_current)
    # Only disable/re-enable if currently in mirror mode
    if [[ "$current" == "mirror" ]] && [[ -n "$EXTERNAL" ]]; then
        # Disable and re-enable the monitor to clear mirror mode
        hyprctl keyword monitor "$EXTERNAL,disable" >/dev/null 2>&1
        sleep 0.2
        hyprctl keyword monitor "$EXTERNAL,preferred,auto-right,1" >/dev/null 2>&1
        sleep 0.1
    fi
}

# Profile definitions
apply_work() {
    disable_mirror
    # Move existing workspaces to correct monitors
    hyprctl dispatch moveworkspacetomonitor 1 $EXTERNAL >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 2 $LAPTOP >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 3 $EXTERNAL >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 4 $EXTERNAL >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 5 $LAPTOP >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 6 $LAPTOP >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 7 $LAPTOP >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 8 $EXTERNAL >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 9 $EXTERNAL >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 10 $EXTERNAL >/dev/null 2>&1

    # Set workspace rules for future workspaces
    hyprctl keyword workspace "1,monitor:$EXTERNAL" >/dev/null 2>&1
    hyprctl keyword workspace "2,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "3,monitor:$EXTERNAL" >/dev/null 2>&1
    hyprctl keyword workspace "4,monitor:$EXTERNAL" >/dev/null 2>&1
    hyprctl keyword workspace "5,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "6,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "7,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "8,monitor:$EXTERNAL" >/dev/null 2>&1
    hyprctl keyword workspace "9,monitor:$EXTERNAL" >/dev/null 2>&1
    hyprctl keyword workspace "10,monitor:$EXTERNAL" >/dev/null 2>&1

    echo "work" > "$STATE_FILE"
}

apply_home() {
    disable_mirror
    # Clear workspace assignments - let workspaces float between monitors
    for i in {1..10}; do
        hyprctl keyword workspace "$i,monitor:" >/dev/null 2>&1
    done

    echo "home" > "$STATE_FILE"
}

apply_meet() {
    disable_mirror
    # Move existing workspaces - personal ones to laptop
    hyprctl dispatch moveworkspacetomonitor 1 $LAPTOP >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 2 $LAPTOP >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 3 $LAPTOP >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 4 $LAPTOP >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 5 $LAPTOP >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 6 $LAPTOP >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 7 $LAPTOP >/dev/null 2>&1

    # Move meeting workspaces to external display
    hyprctl dispatch moveworkspacetomonitor 8 $EXTERNAL >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 9 $EXTERNAL >/dev/null 2>&1
    hyprctl dispatch moveworkspacetomonitor 10 $EXTERNAL >/dev/null 2>&1

    # Set workspace rules for future workspaces
    hyprctl keyword workspace "1,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "2,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "3,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "4,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "5,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "6,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "7,monitor:$LAPTOP" >/dev/null 2>&1
    hyprctl keyword workspace "8,monitor:$EXTERNAL" >/dev/null 2>&1
    hyprctl keyword workspace "9,monitor:$EXTERNAL" >/dev/null 2>&1
    hyprctl keyword workspace "10,monitor:$EXTERNAL" >/dev/null 2>&1

    echo "meet" > "$STATE_FILE"
}

apply_mirror() {
    if [[ -z "$EXTERNAL" ]]; then
        echo "No external monitor detected" >&2
        exit 1
    fi

    # Clear workspace assignments
    for i in {1..10}; do
        hyprctl keyword workspace "$i,monitor:" >/dev/null 2>&1
    done
    
    # Move all workspaces to laptop
    for i in {1..10}; do
        hyprctl dispatch moveworkspacetomonitor "$i" "$LAPTOP" >/dev/null 2>&1
    done
    
    # Enable mirroring on external monitor
    hyprctl keyword monitor "$EXTERNAL,preferred,auto-right,1,mirror,$LAPTOP" >/dev/null 2>&1
    
    echo "mirror" > "$STATE_FILE"
}

get_current() {
    [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || echo "unknown"
}

# Main logic
case "${1}" in
    swap)
        swap_workspace
        ;;
    work)
        apply_work
        ;;
    home)
        apply_home
        ;;
    meet)
        apply_meet
        ;;
    mirror)
        apply_mirror
        ;;
    current)
        echo "Current profile: $(get_current)"
        ;;
    list)
        current=$(get_current)
        echo "  work$([ "$current" = "work" ] && echo " *")"
        echo "  home$([ "$current" = "home" ] && echo " *")"
        echo "  meet$([ "$current" = "meet" ] && echo " *")"
        echo "  mirror$([ "$current" = "mirror" ] && echo " *")"
        ;;
    pick)
        command -v fuzzel >/dev/null || { echo "fuzzel not found" >&2; exit 1; }

        current=$(get_current)
        profiles=("work" "home" "meet" "mirror")

        # Build fuzzel input with current profile marked
        for profile in "${profiles[@]}"; do
            marker=""
            [[ "$profile" = "$current" ]] && marker=" *"
            echo "${profile}${marker}"
        done | fuzzel --dmenu --prompt="Profile: " | {
            read -r selected || exit 0  # Exit silently if cancelled
            selected=${selected% *}  # Remove marker

            case "$selected" in
                work) apply_work ;;
                home) apply_home ;;
                meet) apply_meet ;;
                mirror) apply_mirror ;;
                *) echo "Invalid profile: $selected" >&2; exit 1 ;;
            esac
        }
        ;;
    *)
        echo "Usage: $0 [work|home|meet|mirror|current|list|pick|swap]" >&2
        exit 1
        ;;
esac
