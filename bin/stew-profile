#!/bin/bash

# Hyprland workspace/monitor profile management

set -e

STATE_FILE="$HOME/.cache/hypr_current_profile"
EXTERNAL_CACHE="$HOME/.cache/hypr_external_monitor"
LAPTOP="eDP-1"
EXTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name != "eDP-1") | .name' | head -n1)

# If no external monitor detected but we have a cached name, use it (for unmirror)
if [[ -z "$EXTERNAL" ]] && [[ -f "$EXTERNAL_CACHE" ]]; then
    EXTERNAL=$(cat "$EXTERNAL_CACHE")
elif [[ -n "$EXTERNAL" ]]; then
    # Cache the external monitor name when we see it
    echo "$EXTERNAL" > "$EXTERNAL_CACHE"
fi

mkdir -p "$(dirname "$STATE_FILE")"

# hyprctl keyword and legacy dispatch strings don't work under the lua
# config provider; these helpers pick the matching syntax.
hypr_is_lua() {
    [[ -z "$HYPR_PROVIDER" ]] && HYPR_PROVIDER=$(hyprctl systeminfo | awk '/^configProvider:/{print $2}')
    [[ "$HYPR_PROVIDER" == "lua" ]]
}

move_ws_to_monitor() { # <workspace> <monitor>
    if hypr_is_lua; then
        hyprctl dispatch "hl.dsp.workspace.move({workspace = $1, monitor = \"$2\"})" >/dev/null 2>&1
    else
        hyprctl dispatch moveworkspacetomonitor "$1" "$2" >/dev/null 2>&1
    fi
}

set_ws_rule() { # <workspace> <monitor, empty to clear>
    if hypr_is_lua; then
        hyprctl eval "hl.workspace_rule({workspace = \"$1\", monitor = \"$2\"})" >/dev/null 2>&1
    else
        hyprctl keyword workspace "$1,monitor:$2" >/dev/null 2>&1
    fi
}

enable_monitor() { # <output> [mirror-of]
    local mirror=""
    if hypr_is_lua; then
        [[ -n "${2:-}" ]] && mirror=", mirror = \"$2\""
        hyprctl eval "hl.monitor({output = \"$1\", mode = \"preferred\", position = \"auto-right\", scale = 1$mirror})" >/dev/null 2>&1
    else
        [[ -n "${2:-}" ]] && mirror=",mirror,$2"
        hyprctl keyword monitor "$1,preferred,auto-right,1$mirror" >/dev/null 2>&1
    fi
}

disable_monitor() { # <output>
    if hypr_is_lua; then
        hyprctl eval "hl.monitor({output = \"$1\", disabled = true})" >/dev/null 2>&1
    else
        hyprctl keyword monitor "$1,disable" >/dev/null 2>&1
    fi
}

# workspaces, p=primary, e=external when available
# 1 - e - term
# 2 - p - firefox
# 3 - e - code
# 4 - e - chrome
# 5 - p - slack
# 6 - p - discord
# 7 - p - spotify

swap_workspace() {
  local aw am
  aw=$(hyprctl activeworkspace -j | jq -r '.id')
  am=$(hyprctl activeworkspace -j | jq -r '.monitor')

  if [[ -n "$EXTERNAL" ]]; then
    if [[ "$am" == "$LAPTOP" ]]; then
      move_ws_to_monitor "$aw" "$EXTERNAL"
    elif [[ "$am" == "$EXTERNAL" ]]; then
      move_ws_to_monitor "$aw" "$LAPTOP"
    fi
  fi
}

# Disable mirroring on external monitor
disable_mirror() {
    local current=$(get_current)
    # Only disable/re-enable if currently in mirror mode
    if [[ "$current" == "mirror" ]] && [[ -n "$EXTERNAL" ]]; then
        # Disable and re-enable the monitor to clear mirror mode
        disable_monitor "$EXTERNAL"
        sleep 0.2
        enable_monitor "$EXTERNAL"
        sleep 0.1
    fi
}

# Profile definitions
apply_work() {
    disable_mirror
    # Move existing workspaces to correct monitors
    move_ws_to_monitor 1 "$EXTERNAL"
    move_ws_to_monitor 2 "$LAPTOP"
    move_ws_to_monitor 3 "$EXTERNAL"
    move_ws_to_monitor 4 "$EXTERNAL"
    move_ws_to_monitor 5 "$LAPTOP"
    move_ws_to_monitor 6 "$LAPTOP"
    move_ws_to_monitor 7 "$LAPTOP"
    move_ws_to_monitor 8 "$EXTERNAL"
    move_ws_to_monitor 9 "$EXTERNAL"
    move_ws_to_monitor 10 "$EXTERNAL"

    # Set workspace rules for future workspaces
    set_ws_rule 1 "$EXTERNAL"
    set_ws_rule 2 "$LAPTOP"
    set_ws_rule 3 "$EXTERNAL"
    set_ws_rule 4 "$EXTERNAL"
    set_ws_rule 5 "$LAPTOP"
    set_ws_rule 6 "$LAPTOP"
    set_ws_rule 7 "$LAPTOP"
    set_ws_rule 8 "$EXTERNAL"
    set_ws_rule 9 "$EXTERNAL"
    set_ws_rule 10 "$EXTERNAL"

    echo "work" > "$STATE_FILE"
}

apply_home() {
    disable_mirror
    # Clear workspace assignments - let workspaces float between monitors
    for i in {1..10}; do
        set_ws_rule "$i" ""
    done

    echo "home" > "$STATE_FILE"
}

apply_meet() {
    disable_mirror
    # Move existing workspaces - personal ones to laptop
    move_ws_to_monitor 1 "$LAPTOP"
    move_ws_to_monitor 2 "$LAPTOP"
    move_ws_to_monitor 3 "$LAPTOP"
    move_ws_to_monitor 4 "$LAPTOP"
    move_ws_to_monitor 5 "$LAPTOP"
    move_ws_to_monitor 6 "$LAPTOP"
    move_ws_to_monitor 7 "$LAPTOP"

    # Move meeting workspaces to external display
    move_ws_to_monitor 8 "$EXTERNAL"
    move_ws_to_monitor 9 "$EXTERNAL"
    move_ws_to_monitor 10 "$EXTERNAL"

    # Set workspace rules for future workspaces
    set_ws_rule 1 "$LAPTOP"
    set_ws_rule 2 "$LAPTOP"
    set_ws_rule 3 "$LAPTOP"
    set_ws_rule 4 "$LAPTOP"
    set_ws_rule 5 "$LAPTOP"
    set_ws_rule 6 "$LAPTOP"
    set_ws_rule 7 "$LAPTOP"
    set_ws_rule 8 "$EXTERNAL"
    set_ws_rule 9 "$EXTERNAL"
    set_ws_rule 10 "$EXTERNAL"

    echo "meet" > "$STATE_FILE"
}

apply_mirror() {
    if [[ -z "$EXTERNAL" ]]; then
        echo "No external monitor detected" >&2
        exit 1
    fi

    # Clear workspace assignments
    for i in {1..10}; do
        set_ws_rule "$i" ""
    done

    # Move all workspaces to laptop
    for i in {1..10}; do
        move_ws_to_monitor "$i" "$LAPTOP"
    done

    # Enable mirroring on external monitor
    enable_monitor "$EXTERNAL" "$LAPTOP"

    echo "mirror" > "$STATE_FILE"
}

get_current() {
    [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || echo "unknown"
}

# Main logic
case "${1}" in
    swap)
        swap_workspace
        ;;
    work)
        apply_work
        ;;
    home)
        apply_home
        ;;
    meet)
        apply_meet
        ;;
    mirror)
        apply_mirror
        ;;
    current)
        echo "Current profile: $(get_current)"
        ;;
    list)
        current=$(get_current)
        echo "  work$([ "$current" = "work" ] && echo " *")"
        echo "  home$([ "$current" = "home" ] && echo " *")"
        echo "  meet$([ "$current" = "meet" ] && echo " *")"
        echo "  mirror$([ "$current" = "mirror" ] && echo " *")"
        ;;
    pick)
        command -v fuzzel >/dev/null || { echo "fuzzel not found" >&2; exit 1; }

        current=$(get_current)
        profiles=("work" "home" "meet" "mirror")

        # Build fuzzel input with current profile marked
        for profile in "${profiles[@]}"; do
            marker=""
            [[ "$profile" = "$current" ]] && marker=" *"
            echo "${profile}${marker}"
        done | fuzzel --dmenu --prompt="Profile: " | {
            read -r selected || exit 0  # Exit silently if cancelled
            selected=${selected% *}  # Remove marker

            case "$selected" in
                work) apply_work ;;
                home) apply_home ;;
                meet) apply_meet ;;
                mirror) apply_mirror ;;
                *) echo "Invalid profile: $selected" >&2; exit 1 ;;
            esac
        }
        ;;
    *)
        echo "Usage: $0 [work|home|meet|mirror|current|list|pick|swap]" >&2
        exit 1
        ;;
esac
